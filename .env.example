# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Часовой пояс, в котором бот показывает время
TIMEZONE=Europe/Moscow

# Интервал по умолчанию для новых каналов (в часах, можно дробный: 1.5)
DEFAULT_INTERVAL_HOURS=1

# Путь к базе SQLite
DB_PATH=data/bot.db

# Необязательно: id пользователей Telegram через запятую, которым разрешено пользоваться ботом.
# Пусто — пользоваться может любой, но только для каналов, где он сам администратор.
ALLOWED_USERS=
